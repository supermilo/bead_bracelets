CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/bracelet_builder
# CELERY_RESULT_BACKEND is unset by default (no result backend — fire-and-forget .delay() only).
# Set this only if something starts polling task results (.get()/AsyncResult).
#CELERY_RESULT_BACKEND=redis://localhost:6379/0

SITE_PROTOCOL=http://
SITE_DOMAIN=localhost:8000

STRIPE_PUBLIC_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key

# EMAIL_BACKEND defaults to the console backend if unset — leave the rest
# blank for local dev. Switch to django.core.mail.backends.smtp.EmailBackend
# and fill in the EMAIL_HOST_* values to send real mail (e.g. via Gmail, an
# app password, not your account password, is required for EMAIL_HOST_PASSWORD).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@bracelet-builder.local

# Comma-separated list of admin notification email addresses, e.g.
# "admin@example.com,ops@example.com". Blank by default (no admin emails sent).
ADMINS=
